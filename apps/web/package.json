{
  "name": "artist-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "deploy:prod": "vercel deploy --prod --yes",
    "test:foundation": "node scripts/frontend-foundation-smoke.mjs",
    "test:playback-resolver-fallback": "node --import ./scripts/register-alias.mjs scripts/test-playback-resolver-fallback.mjs",
    "test:direct-preview-cdn": "node --import ./scripts/register-alias.mjs scripts/test-direct-preview-cdn.mjs",
    "backfill:stream-assets": "node --import ./scripts/register-alias.mjs scripts/backfill-stream-assets.mjs",
    "backfill:playback-keys": "node --import ./scripts/register-alias.mjs scripts/backfill-playback-keys.mjs",
    "check:frontend-guardrails": "node scripts/check-frontend-guardrails.mjs",
    "verify:foundation": "node scripts/recovery/verify-foundation.mjs",
    "recover:foundation": "node scripts/recovery/recover-foundation.mjs",
    "recover:stable": "node scripts/recovery/recover-stable.mjs",
    "recover:rollback": "node scripts/recovery/recover-rollback.mjs",
    "recover:deploy": "node scripts/recovery/recover-deploy.mjs",
    "snapshot:foundation": "node scripts/recovery/create-frontend-snapshot.mjs",
    "recover:checkpoint": "node scripts/recovery/create-frontend-checkpoint.mjs",
    "verify:dr-readiness": "node scripts/recovery/verify-platform-dr-readiness.mjs",
    "test:batch1": "node --import ./scripts/register-alias.mjs scripts/test-batch1-regression.mjs",
    "test:core-invariants": "node --test src/lib/playback-core/__tests__/invariants.test.js",
    "test:admin-upload": "node --import ./scripts/register-alias.mjs --test src/lib/media/__tests__/admin-upload-hardening.test.js src/lib/media/__tests__/catalog-db.test.js src/lib/storefront/__tests__/catalog-refresh-contract.test.js",
    "test:release-lifecycle": "node --test src/lib/releases/__tests__/release-availability.test.js",
    "test:auth-security": "node --import ./scripts/register-alias.mjs --test src/lib/auth/__tests__/*.test.js",
    "test:playback-physical": "node --experimental-loader ./src/lib/playback-core/__tests__/physical/alias-loader.mjs --test src/lib/playback-core/__tests__/physical/differential.test.mjs src/lib/playback-core/__tests__/physical/effect-authority.test.mjs src/lib/playback-core/__tests__/physical/hardening-b.test.mjs src/lib/playback-core/__tests__/physical/geometry-isolation.test.mjs",
    "test:signal-path-contracts": "node --import ./scripts/register-alias.mjs --test src/lib/architecture/__tests__/*.test.js src/lib/media/__tests__/media-session-artwork.test.js",
    "test:architecture-critical": "npm run test:core-invariants && npm run test:playback-physical && npm run test:auth-security && npm run test:admin-upload && npm run test:release-lifecycle && npm run test:signal-path-contracts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1051.0",
    "@aws-sdk/s3-request-presigner": "3.1051.0",
    "@sentry/nextjs": "^10.68.0",
    "@stripe/react-stripe-js": "6.2.0",
    "@stripe/stripe-js": "9.2.0",
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.105.4",
    "@tanstack/react-virtual": "3.13.25",
    "@types/howler": "2.2.13",
    "@types/three": "0.184.1",
    "@upstash/redis": "^1.38.0",
    "@vercel/kv": "^3.0.0",
    "colorthief": "3.3.1",
    "d3-geo": "^3.1.1",
    "framer-motion": "12.38.0",
    "hls.js": "^1.6.16",
    "howler": "2.2.4",
    "lucide-react": "1.16.0",
    "next": "16.2.4",
    "posthog-js": "1.376.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "22.0.2",
    "three": "0.184.0",
    "topojson-client": "^3.1.0",
    "web-push": "3.6.7",
    "world-atlas": "^2.0.2",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "4.2.2",
    "vercel": "54.7.1"
  }
}
