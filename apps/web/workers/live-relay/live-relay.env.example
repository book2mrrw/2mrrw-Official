# Copy to live-relay.env on the host (never commit it): the relay's whole host
# configuration. The same image and mediamtx.yml run on Fly.

# The relay's public name: Caddy gets its certificate for it, and browsers are
# told to send media to it. DNS must point here; open TCP 80/443 and UDP+TCP 8189.
LIVE_RELAY_DOMAIN=live.2mrrw.com
MTX_WEBRTCADDITIONALHOSTS=live.2mrrw.com
# Only Caddy (the compose edge network) may set forwarded client addresses.
MTX_WEBRTCTRUSTEDPROXIES=172.31.250.0/24

# The website that authorizes publishing and hands out the Twitch ingest.
LIVE_PLATFORM_ORIGIN=https://www.2mrrw.com
# Only when a publisher sends something other than H.264 (re-encoded).
TWITCH_VIDEO_BITRATE=4500k
# Shared with the website (Vercel LIVE_RELAY_SERVICE_SECRET). Rotate it when
# moving hosts: set a new value here and on Vercel at the same time.
LIVE_RELAY_SERVICE_SECRET=
