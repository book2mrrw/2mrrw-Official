# Copy to cover-art.env on the host (never commit it). The same variables on every host.
# Database: the lane's own login (role cover_art_worker), which can only claim and
# finish cover-art jobs. Session pooler, no sslmode parameter (TLS is verified
# against certs/supabase-root-2021.crt).
COVER_ART_DATABASE_URL=postgresql://cover_art_worker.qvfbgkbgczyqrglvgyqr:PASSWORD@aws-1-us-east-2.pooler.supabase.com:5432/postgres
# Media bucket: an R2 API token with Object Read & Write on the bucket below. The
# worker refuses to write anywhere but cover-art/ and only reads originals.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=2mrrw-media
# Optional: how long an idle worker waits before checking the queue again.
IDLE_POLL_MS=10000
