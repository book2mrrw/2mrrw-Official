# Copy to hls-lanes.env on the host (never commit it); chmod 600.
#
# The video lanes (music videos, vault videos, track visuals) are keyless: no
# service-role key, no storage key, no master secret on the host. The one
# secret is the lanes' own database login, hls_media_worker, which can call the
# lane functions and nothing else (its password is set once with ALTER ROLE ...
# PASSWORD '<SCRAM verifier>'; a new host reuses it or a new one is set). The
# website hands each job its storage links and content key per lease.
HLS_MEDIA_DATABASE_URL=postgresql://hls_media_worker.qvfbgkbgczyqrglvgyqr:<password>@aws-1-us-east-2.pooler.supabase.com:5432/postgres
HLS_LANE_API_URL=https://www.2mrrw.com
LOG_LEVEL=info
IDLE_POLL_MS=5000
