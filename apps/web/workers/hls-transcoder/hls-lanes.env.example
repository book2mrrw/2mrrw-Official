# Copy to hls-lanes.env on the host (never commit it); chmod 600.
# The same values the Fly lanes use. Fly's and Vercel's copies cannot be read
# back, so they come from where they were first recorded (password manager).
SUPABASE_URL=https://qvfbgkbgczyqrglvgyqr.supabase.co
SUPABASE_SECRET_KEY=
R2_ACCOUNT_ID=992d4f5d45e7c56189a518c2f417fe25
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=2mrrw-media
# MUST equal the website's (Vercel) values: they derive the AES keys of every
# published music video, vault video and track visual. A different value makes
# already-published video undecryptable — never rotate them here alone.
HLS_MASTER_SECRET=
TRACK_VISUAL_MASTER_SECRET=
# The website (job completion callbacks) and the token it expects from workers.
APP_URL=https://www.2mrrw.com
HLS_WORKER_API_TOKEN=
LOG_LEVEL=info
IDLE_POLL_MS=5000
