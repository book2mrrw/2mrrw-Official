{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install --legacy-peer-deps",
  "crons": [
    { "path": "/api/cron/expire-gifts", "schedule": "0 0 * * *" },
    { "path": "/api/cron/gift-reminders", "schedule": "0 10 * * *" },
    { "path": "/api/cron/purge-stream-events", "schedule": "0 3 * * 0" },
    { "path": "/api/cron/hls-stale-jobs", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/livestream-notifications", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/twitch-live-reconcile", "schedule": "* * * * *" },
    { "path": "/api/cron/publish-scheduled", "schedule": "* * * * *" },
    { "path": "/api/cron/finalize-draft-dumps", "schedule": "* * * * *" },
    { "path": "/api/cron/account-lifecycle", "schedule": "*/5 * * * *" }
  ]
}
