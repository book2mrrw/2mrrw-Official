diff --git a/apps/web/src/lib/lyrics/draft-store.js b/apps/web/src/lib/lyrics/draft-store.js
new file mode 100644
index 00000000..7be5ff05
--- /dev/null
+++ b/apps/web/src/lib/lyrics/draft-store.js
@@ -0,0 +1,22 @@
+import {decodeLyrics,MAX_LYRIC_LENGTH} from './timing.js';
+const uuid=/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i;
+const fail=(status,error)=>({status,body:{error}});
+function outcome(result) {
+  const {data,error}=result;
+  if(!error)return {status:200,body:{ok:true,...data}};
+  if(error.code==='40001')return fail(409,error.message);
+  if(error.code==='22023')return fail(422,error.message);
+  return fail(503,['PGRST202','42P01','PGRST205'].includes(error.code)?'Server draft saving is not available yet. Your device copy is retained.':'The lyric draft could not be saved or loaded. Your device copy is retained.');
+}
+export async function readLyricDraft(admin,actorId,releaseId,recordingId) {
+  if(![actorId,releaseId,recordingId].every(value=>uuid.test(value||'')))return fail(400,'Valid release and recording identities are required.');
+  return outcome(await admin.rpc('get_recording_lyric_draft',{p_actor_id:actorId,p_release_ref_id:releaseId,p_recording_id:recordingId}));
+}
+export async function saveLyricDraft(admin,actorId,releaseId,body) {
+  if(![actorId,releaseId,body?.recording_id].every(value=>uuid.test(value||'')))return fail(400,'Valid release and recording identities are required.');
+  if(body.expected_draft_revision!=null&&!uuid.test(body.expected_draft_revision))return fail(400,'Invalid draft revision.');
+  if(typeof body.lyrics!=='string'||typeof body.base_lyrics!=='string'||body.lyrics.length>MAX_LYRIC_LENGTH||body.base_lyrics.length>MAX_LYRIC_LENGTH)return fail(422,'The lyric draft exceeds the text size limit.');
+  const decoded=decodeLyrics(body.lyrics);
+  if(decoded.error)return fail(422,decoded.error);
+  return outcome(await admin.rpc('save_recording_lyric_draft',{p_actor_id:actorId,p_release_ref_id:releaseId,p_recording_id:body.recording_id,p_expected_draft_revision:body.expected_draft_revision??null,p_base_lyrics:body.base_lyrics,p_lyrics:body.lyrics}));
+}
diff --git a/apps/web/src/lib/lyrics/working-draft.js b/apps/web/src/lib/lyrics/working-draft.js
new file mode 100644
index 00000000..0f5b2614
--- /dev/null
+++ b/apps/web/src/lib/lyrics/working-draft.js
@@ -0,0 +1,107 @@
+import {createDraftSaveQueue} from '../credits/draft-save-queue.js';
+import {MAX_LYRIC_LENGTH} from './timing.js';
+
+export const lyricDraftKey=(author,release,recording)=>`2mrrw.lyric-draft.v1:${author}:${release}:${recording}`;
+
+/** Private working copy, independent of published lyrics. Device writes are
+ * synchronous; server writes are serialized/CAS-protected by the existing queue.
+ */
+export function createLyricWorkingDraft({authorId,releaseId,recordingId,baseline='',value='',storage,request=fetch,restore=()=>{},onState=()=>{},delay=3000}) {
+  const key=lyricDraftKey(authorId,releaseId,recordingId),url=`/api/admin/releases/${encodeURIComponent(releaseId)}`;
+  const draftUrl=`${url}?lyric_draft=${encodeURIComponent(recordingId)}&draft_owner=${encodeURIComponent(authorId)}`;
+  let latest=value,local=null,revision=null,serverValue=baseline,available=false,conflict=false,remote=null,touched=false,timer=null,loading=null,disposed=false,controller=null,started=false,staleBase=false;
+  let cachedLyrics;
+  const notify=state=>onState({...state,cachedLyrics});
+  const read=()=>{try{const data=JSON.parse(storage?.getItem(key)||'null');return data?.version===1&&typeof data.lyrics==='string'&&data.lyrics.length<=MAX_LYRIC_LENGTH&&typeof data.baseLyrics==='string'?data:null;}catch{return null;}};
+  const cache=(intent=touched)=>{
+    const record={version:1,lyrics:latest,baseLyrics:baseline,serverRevision:revision,updatedAt:Date.now(),intent};
+    try{if(!storage)throw Error();storage.setItem(key,JSON.stringify(record));local=record;cachedLyrics=latest;return true;}catch{return false;}
+  };
+  const queue=createDraftSaveQueue({
+    onState:state=>notify(state.status==='saved'?{status:latest===serverValue?'saved':'local'}:state),
+    send:async(snapshot,expected,options)=>{
+      const body=JSON.stringify({lyric_draft_version:1,draft_owner_id:authorId,recording_id:recordingId,expected_draft_revision:expected,base_lyrics:baseline,lyrics:snapshot.lyrics});
+      const response=await request(url,{method:'PATCH',headers:{'Content-Type':'application/json'},body,keepalive:options.keepalive===true&&new TextEncoder().encode(body).length<60000});
+      let data=await response.json(),accepted=response.ok&&data.ok&&typeof data.revision==='string'&&data.revision.length>0;
+      if(response.status===409){
+        const check=await request(draftUrl,{cache:'no-store'}),current=await check.json();
+        if(check.ok&&current.ok&&Object.hasOwn(current,'revision')&&(current.revision===null||typeof current.revision==='string')&&current.base_lyrics===baseline&&(current.draft?.lyrics??baseline)===snapshot.lyrics){data={ok:true,revision:current.revision};accepted=true;}
+      }
+      if(accepted){
+        revision=data.revision;serverValue=snapshot.lyrics;
+        const current=read();
+        if(current){try{storage.setItem(key,JSON.stringify({...current,serverRevision:revision}));}catch{}}
+        if(latest===snapshot.lyrics)cachedLyrics=latest; // Server durability also protects exit when device storage fails.
+      }else if(response.status===409){conflict=true;available=false;}
+      return {...data,ok:accepted,status:accepted?200:response.status,saved_at:data.revision};
+    },
+  });
+  const schedule=()=>{
+    clearTimeout(timer);
+    if(available&&!conflict&&latest!==serverValue&&!disposed)timer=setTimeout(()=>flush().catch(()=>{}),delay);
+  };
+  const flush=async(options={})=>{
+    clearTimeout(timer);
+    if(!available||conflict)return false;
+    if(latest===serverValue){notify({status:'saved'});return true;}
+    try{await queue.enqueue({lyrics:latest},options);return true;}
+    catch(error){notify({status:conflict?'conflict':'local',error:error.message});return false;}
+  };
+  const adopt=lyrics=>{latest=lyrics;restore(lyrics);cache();};
+  const load=()=>{
+    if(loading)return loading;
+    const requestController=new AbortController();controller=requestController;
+    const operation=(async()=>{
+      try{
+        const response=await request(draftUrl,{cache:'no-store',signal:requestController.signal});
+        const data=await response.json();if(!response.ok||!data.ok||typeof data.base_lyrics!=='string'||!Object.hasOwn(data,'revision'))throw Error(data.error||'Server drafts are temporarily unavailable.');
+        if(disposed||requestController.signal.aborted)return false;
+        remote=data;revision=data.revision??null;
+        if(data.base_lyrics!==baseline){conflict=true;notify({status:'conflict',error:'Published lyrics changed. Reopen this release; your device copy is retained.'});return false;}
+        const working=local?.intent||local?.lyrics!==baseline&&!!local;
+        if(staleBase||data.draft&&((working||touched)&&data.draft.lyrics!==latest&&local?.serverRevision!==revision||data.draft.base_lyrics!==baseline)){
+          conflict=true;notify({status:'conflict',error:'Another saved version is available. Choose which draft to continue.',canChoose:true});return false;
+        }
+        available=true;conflict=false;queue.restoreRevision(revision);serverValue=data.draft?.lyrics??baseline;
+        if(!working&&!touched&&data.draft)adopt(data.draft.lyrics);
+        notify({status:latest===serverValue?(data.draft?'saved':'idle'):'local'});schedule();return true;
+      }catch(error){
+        if(disposed||requestController.signal.aborted)return false;
+        available=false;const cached=cache();notify({status:cached?'local':'error',error:error.message});return false;
+      }
+    })();
+    loading=operation;operation.finally(()=>{if(loading===operation)loading=null;}).catch(()=>{});return operation;
+  };
+  return {
+    seed(lyrics){if(!started)latest=lyrics;},
+    start(){
+      disposed=false;started=true;if(controller?.signal.aborted)loading=null;
+      local=read();
+      if(local){
+        revision=local.serverRevision??null;cachedLyrics=local.lyrics;
+        if(local.lyrics!==latest){latest=local.lyrics;restore(latest);}
+        if(local.baseLyrics!==baseline&&local.lyrics!==baseline){staleBase=true;conflict=true;notify({status:'conflict',error:'A device draft belongs to an earlier saved version. Review it before continuing.'});}
+      }
+      return load();
+    },
+    buffer(lyrics){
+      latest=lyrics;touched=true;
+      const cached=cache(true);notify({status:cached?'local':'error',error:cached?undefined:'Device recovery is unavailable. Use Save draft before leaving.'});schedule();
+    },
+    async save(){
+      const cached=cache(true);touched=true;
+      if(!available&&!conflict)await load();
+      if(!available||conflict){if(!conflict)notify({status:cached?'local':'error',error:cached?'Saved on this device. Server sync is unavailable.':'Neither device recovery nor server saving is available. Keep this page open.'});return false;}
+      return flush();
+    },
+    review:load,
+    choose(useSaved){
+      if(!remote||remote.base_lyrics!==baseline)return;
+      conflict=false;staleBase=false;available=true;revision=remote.revision??null;queue.restoreRevision(revision);serverValue=remote.draft?.lyrics??baseline;
+      if(useSaved)adopt(serverValue);
+      touched=true;cache(true);notify({status:latest===serverValue?'saved':'local'});schedule();
+    },
+    dispose(){clearTimeout(timer);controller?.abort();flush({keepalive:true}).catch(()=>{});disposed=true;},
+    flush,
+  };
+}
diff --git a/apps/web/supabase/migrations/20261024010000_private_lyric_working_drafts.sql b/apps/web/supabase/migrations/20261024010000_private_lyric_working_drafts.sql
new file mode 100644
index 00000000..df88e394
--- /dev/null
+++ b/apps/web/supabase/migrations/20261024010000_private_lyric_working_drafts.sql
@@ -0,0 +1,67 @@
+-- Private authoring state for existing canonical and legacy recordings.
+-- Separate from listener lyrics and from release_drafts (draft releases only).
+BEGIN;
+CREATE TABLE public.recording_lyric_drafts (
+ author_id uuid NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
+ release_ref_id uuid NOT NULL,
+ recording_id uuid NOT NULL,
+ lyrics text NOT NULL CHECK(length(lyrics)<=250000),
+ base_lyrics text NOT NULL CHECK(length(base_lyrics)<=250000),
+ revision uuid NOT NULL DEFAULT gen_random_uuid(),
+ saved_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+ PRIMARY KEY(author_id,release_ref_id,recording_id)
+);
+ALTER TABLE public.recording_lyric_drafts ENABLE ROW LEVEL SECURITY;
+REVOKE ALL ON public.recording_lyric_drafts FROM PUBLIC,anon,authenticated;
+GRANT SELECT,INSERT,UPDATE,DELETE ON public.recording_lyric_drafts TO service_role;
+
+CREATE FUNCTION public._lyric_draft_current_lyrics(p_release_ref_id uuid,p_recording_id uuid) RETURNS text
+LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public AS $$
+DECLARE r public.releases;p public.products;value text;
+BEGIN
+ SELECT * INTO r FROM public.releases WHERE id=p_release_ref_id AND deleted_at IS NULL FOR SHARE;
+ IF r.id IS NOT NULL THEN
+  SELECT COALESCE(lyrics,'') INTO value FROM public.tracks WHERE id=p_recording_id AND release_id=r.id AND removed_from_release_at IS NULL FOR SHARE;
+ ELSE
+  SELECT * INTO p FROM public.products WHERE id=p_release_ref_id AND deleted_at IS NULL FOR SHARE;
+  IF p.id IS NULL OR p.release_id IS NOT NULL THEN RAISE EXCEPTION 'Use a current canonical release identity' USING ERRCODE='22023';END IF;
+  IF p_recording_id=p.id AND p.product_type IN ('single','feature') AND NOT EXISTS(SELECT 1 FROM public.catalog_tracks WHERE product_id=p.id AND removed_from_release_at IS NULL) THEN
+   value=COALESCE(p.metadata->>'lyrics','');
+  ELSE
+   SELECT COALESCE(lyrics,metadata->>'lyrics','') INTO value FROM public.catalog_tracks WHERE id=p_recording_id AND product_id=p.id AND removed_from_release_at IS NULL FOR SHARE;
+  END IF;
+ END IF;
+ IF value IS NULL THEN RAISE EXCEPTION 'Recording does not belong to this release' USING ERRCODE='22023';END IF;
+ RETURN value;
+END;$$;
+
+CREATE FUNCTION public.get_recording_lyric_draft(p_actor_id uuid,p_release_ref_id uuid,p_recording_id uuid) RETURNS jsonb
+LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public AS $$
+DECLARE d public.recording_lyric_drafts;baseline text;
+BEGIN
+ baseline=public._lyric_draft_current_lyrics(p_release_ref_id,p_recording_id);
+ SELECT * INTO d FROM public.recording_lyric_drafts WHERE author_id=p_actor_id AND release_ref_id=p_release_ref_id AND recording_id=p_recording_id;
+ RETURN jsonb_build_object('base_lyrics',baseline,'revision',d.revision,'draft',CASE WHEN d.revision IS NULL OR d.lyrics=baseline THEN NULL ELSE jsonb_build_object('lyrics',d.lyrics,'base_lyrics',d.base_lyrics,'revision',d.revision,'saved_at',d.saved_at) END);
+END;$$;
+
+CREATE FUNCTION public.save_recording_lyric_draft(p_actor_id uuid,p_release_ref_id uuid,p_recording_id uuid,p_expected_draft_revision uuid,p_base_lyrics text,p_lyrics text) RETURNS jsonb
+LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog,public AS $$
+DECLARE d public.recording_lyric_drafts;baseline text;next_revision uuid=gen_random_uuid();saved timestamptz=clock_timestamp();
+BEGIN
+ IF p_actor_id IS NULL OR p_lyrics IS NULL OR p_base_lyrics IS NULL OR length(p_lyrics)>250000 OR length(p_base_lyrics)>250000 THEN RAISE EXCEPTION 'Invalid lyric draft' USING ERRCODE='22023';END IF;
+ -- Serialize first inserts as well as later CAS writes. Publishers use the
+ -- same parent/recording rows, so baseline comparison remains transactional.
+ PERFORM pg_advisory_xact_lock(hashtextextended(p_actor_id::text||p_release_ref_id::text||p_recording_id::text,0));
+ baseline=public._lyric_draft_current_lyrics(p_release_ref_id,p_recording_id);
+ IF p_base_lyrics IS DISTINCT FROM baseline THEN RAISE EXCEPTION 'Published lyrics changed; reopen before saving this draft' USING ERRCODE='40001';END IF;
+ SELECT * INTO d FROM public.recording_lyric_drafts WHERE author_id=p_actor_id AND release_ref_id=p_release_ref_id AND recording_id=p_recording_id FOR UPDATE;
+ IF p_expected_draft_revision IS DISTINCT FROM d.revision THEN RAISE EXCEPTION 'A newer draft was saved in another editor' USING ERRCODE='40001';END IF;
+ INSERT INTO public.recording_lyric_drafts(author_id,release_ref_id,recording_id,lyrics,base_lyrics,revision,saved_at)
+ VALUES(p_actor_id,p_release_ref_id,p_recording_id,p_lyrics,p_base_lyrics,next_revision,saved)
+ ON CONFLICT(author_id,release_ref_id,recording_id) DO UPDATE SET lyrics=EXCLUDED.lyrics,base_lyrics=EXCLUDED.base_lyrics,revision=EXCLUDED.revision,saved_at=EXCLUDED.saved_at;
+ RETURN jsonb_build_object('revision',next_revision,'saved_at',saved);
+END;$$;
+REVOKE ALL ON FUNCTION public._lyric_draft_current_lyrics(uuid,uuid),public.get_recording_lyric_draft(uuid,uuid,uuid),public.save_recording_lyric_draft(uuid,uuid,uuid,uuid,text,text) FROM PUBLIC,anon,authenticated;
+GRANT EXECUTE ON FUNCTION public.get_recording_lyric_draft(uuid,uuid,uuid),public.save_recording_lyric_draft(uuid,uuid,uuid,uuid,text,text) TO service_role;
+NOTIFY pgrst,'reload schema';
+COMMIT;
