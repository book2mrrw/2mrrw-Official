# PostHog (Phase 11 telemetry — production/preview only; opted out in development)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Control System catalog (existing)
NEXT_PUBLIC_CONTROL_SYSTEM_API_URL=

# Cloudflare R2 (storefront playback + catalog CDN)
# S3 API endpoint — https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=2mrrw-media
# Public r2.dev URL with bucket public access enabled (previews/, images/, artwork/)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-643e4a94e0184b1fabf6522cfbb16f75.r2.dev
# Optional: log R2 env presence in /api/library/stream (no secret values)
# R2_STREAM_DEBUG=1
