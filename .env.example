# ─────────────────────────────────────────────────────────────────────────────
# 2mrrw / artist-platform — environment reference
#
# Generated by diffing every `process.env.X` reference in apps/web/src,
# workers/, and scripts/ against what was previously documented here (20 of
# 84+ vars). This file is the single source of truth going forward — when you
# add a new process.env.X reference, add it here in the same change.
#
# Sections marked [APP] are required for the deployed Next.js app (apps/web)
# to run correctly in production. [WORKER] vars belong to the separately
# deployed Fly.io HLS transcoder (workers/hls-transcoder) — they are Fly
# secrets, not Vercel env vars, and are only listed here for visibility.
# [SCRIPT] vars are read only by one-off local/CLI tooling under scripts/ —
# never required for the running app itself.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase [APP] ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy/alternate names some code paths still read — keep in sync with the
# NEXT_PUBLIC_ ones above if both are present.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service-role key — full table access, bypasses RLS. Server-only, never expose.
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
# Direct transaction-pooler connection used server-side only for encrypted
# Twitch OAuth persistence when the REST schema cache is unavailable.
POSTGRES_URL=

# ── Admin authority [APP] ────────────────────────────────────────────────────
# Admin authority is keyed to immutable user identity (ADMIN_USER_ID and/or the
# server-controlled admin_principals table), never a mutable profile role/email.
# ADMIN_EMAIL is retained for non-authority operational configuration only.
ADMIN_EMAIL=
ADMIN_USER_ID=
NEXT_PUBLIC_ADMIN_EMAIL=
# Production human-admin requests require the durable, session-bound authority
# minted by the existing login OTP flow. Must be exactly true in production.
# Missing, empty, malformed, or explicit false all fail closed in production —
# see src/lib/auth/mfa-policy.js. A misconfiguration here locks out every
# admin platform-wide; alert on ADMIN_AUTH_MFA_CONFIGURATION_ERROR events.
HUMAN_ADMIN_MFA_REQUIRED=true
ADMIN_MFA_POLICY=
# Deprecated bearer secret — no longer read for admin authority. Retained only
# if LEGACY_SEED_ROUTES_ENABLED explicitly re-enables an old route.
ADMIN_SEED_SECRET=
LEGACY_SEED_ROUTES_ENABLED=

# ── Guest sessions [APP] ─────────────────────────────────────────────────────
GUEST_SESSION_SECRET=
# Set during a planned rotation so both the old and new secret verify guest
# cookies at once; remove once every guest cookie has rotated onto the new one.
GUEST_SESSION_SECRET_PREVIOUS=

# ── Cron / service-to-service capabilities [APP] ────────────────────────────
# One shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`
# on every scheduled invocation (see vercel.json "crons" + src/app/api/cron/*).
CRON_SECRET=
# Named service capabilities (src/lib/auth/admin-api-guard.js) — each is its
# own credential scoped to ONE integration. An unconfigured capability grants
# nothing (fails closed), it never falls back to another capability's secret.
HLS_WORKER_API_TOKEN=
SVC_CATALOG_SYNC_SECRET=
SVC_CATALOG_INGEST_SECRET=
SVC_CATALOG_REVALIDATE_SECRET=
SVC_DROP_NOTIFICATION_SECRET=
SVC_DIAGNOSTICS_SECRET=
SVC_PRODUCT_SEED_SECRET=
SVC_FULFILL_RECOVERY_SECRET=
SVC_R2_CORS_SECRET=
SVC_PLAYBACK_BACKFILL_SECRET=

# ── Stripe [APP] ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Inner Circle subscription product — see src/lib/commerce/stripe-entitlements.js
STRIPE_INNER_CIRCLE_PRICE_ID=
STRIPE_INNER_CIRCLE_PRODUCT_ID=

# ── Cloudflare R2 (storefront playback + catalog CDN) [APP] ─────────────────
# S3 API endpoint — https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=2mrrw-media
# Public r2.dev URL with bucket public access enabled (previews/, images/, artwork/)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-643e4a94e0184b1fabf6522cfbb16f75.r2.dev
NEXT_PUBLIC_R2_CDN_URL=
# Optional: log R2 env presence in /api/library/stream (no secret values)
# R2_STREAM_DEBUG=1

# ── R2 / S3 — recovery & migration tooling only [SCRIPT] ────────────────────
# Some one-off scripts under scripts/recovery/ and scripts/migrate-r2-bucket.mjs
# use plain AWS-SDK-convention names instead of the CLOUDFLARE_R2_* ones above
# (so they can double as a raw `aws s3` CLI config) — this is intentional, not
# a naming drift with the app's own config. Not required for the running app.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ENDPOINT_URL_S3=
R2_ACCESS_KEY_ID=
R2_ACCOUNT_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
BUCKET_NAME=
F0_R2_RESTORE_PREFIX=
F0_CLONE_REF=
F0_STRIPE_EXE=

# ── HLS transcoding ──────────────────────────────────────────────────────────
# [APP] — signs/verifies HLS manifest & segment URLs
HLS_HMAC_SECRET=
# Set during a planned rotation so both secrets verify at once; remove after rotation.
HLS_HMAC_SECRET_PREVIOUS=
# [WORKER] — Fly.io hls-transcoder secrets (see workers/hls-transcoder/fly.toml).
# APP_URL must point at the deployed app so the worker's completion webhook
# (POST {APP_URL}/api/admin/hls/complete) can reach it — see this session's
# fix history: this was found unset in production, silently degrading cache
# invalidation after a transcode until the DB-level fix removed the dependency.
APP_URL=
HLS_MASTER_SECRET=
FFMPEG_PATH=

# ── Collector cards ──────────────────────────────────────────────────────────
# [APP] Intended signing secret for collector-card JWTs. If unset, code falls
# back to GUEST_SESSION_SECRET (src/lib/verifyCardToken.js) — set this
# explicitly so card tokens don't share a trust domain with guest sessions.
COLLECTOR_CARD_JWT_SECRET=
COLLECTOR_IP_HASH_SECRET=

# ── Gifts ─────────────────────────────────────────────────────────────────────
GIFT_REMINDER_SIGNING_SECRET=
GIFT_EMAIL_FROM=
TRANSACTIONAL_EMAIL_FROM=
RESEND_API_KEY=

# ── Push notifications (Web Push / VAPID) ───────────────────────────────────
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=

# ── Twilio (SMS) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Twitch (livestream reconciliation) ──────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_LOGIN=
TWITCH_WEBHOOK_BASE_URL=
TWITCH_WEBHOOK_SECRET=
# Encrypts stored Twitch user OAuth tokens at rest — must decode to exactly 32 bytes.
TWITCH_OAUTH_TOKEN_ENCRYPTION_KEY=

# ── Direct browser broadcast relay [APP + WORKER] ───────────────────────────
# [APP] Public HTTPS origin of the warm Fly MediaMTX relay (no path suffix).
LIVE_RELAY_PUBLISH_BASE_URL=https://2mrrw-live-relay.fly.dev
# [APP + WORKER] Shared HMAC key for short-lived publish grants. Use the same
# random value in Vercel and Fly; minimum 32 bytes. Never expose to the browser.
LIVE_RELAY_TOKEN_SECRET=
# [APP + WORKER] Dedicated machine credential used only for the relay to fetch
# a current Twitch ingest destination. Use the same random 32+ byte value.
LIVE_RELAY_SERVICE_SECRET=
# [WORKER] Platform origin and optional relay output tuning.
LIVE_PLATFORM_ORIGIN=https://www.2mrrw.com
TWITCH_VIDEO_BITRATE=4500k

# ── Printful (merch fulfillment) ────────────────────────────────────────────
PRINTFUL_API_KEY=

# [APP] Optional. Enables real geocoding (src/lib/geo/geocode-profile.js) for
# fan city-dot precision on the Global Analytics map, beyond the free curated
# CITY_COORDS table. Unset is fully supported — geocoding just falls back to
# that table (and, past it, the map's existing country-centroid fallback).
MAPBOX_GEOCODING_TOKEN=

# ── Upstash Redis (entitlement cache) ───────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Rate limiting (Vercel KV integration — auto-injected, do not rename) ────
# src/lib/server/rate-limit.js reads this exact, integration-specific pair
# rather than the generic UPSTASH_REDIS_REST_* above. Falls back to a Supabase
# table (api_rate_limits) when unset, so it degrades rather than breaking.
rate_limits_2mrrw_KV_REST_API_URL=
rate_limits_2mrrw_KV_REST_API_TOKEN=

# ── Account lifecycle (delete/export — GDPR-style requests) ─────────────────
# Envelope-encryption key for exported account data (src/lib/account-lifecycle).
ACCOUNT_EXPORT_KEK_BASE64=
ACCOUNT_EXPORT_KEK_VERSION=
ACCOUNT_LIFECYCLE_PSEUDONYM_KEY=
# The cron (src/app/api/cron/account-lifecycle) no-ops unless this is exactly
# "true" — schema being present does not mean requests are actually processed.
ACCOUNT_LIFECYCLE_EXECUTION_ENABLED=

# ── Creator / ownership authority ───────────────────────────────────────────
CREATOR_EMAILS=
CREATOR_USER_IDS=
OWNERSHIP_AUTHORITY_STATE=
OWNERSHIP_DIVERGENCE_LOG=

# ── Observability / Sentry ───────────────────────────────────────────────────
# Required for error tracking to actually capture anything — see
# sentry.{client,server,edge}.config.js. Without a DSN the SDK silently
# no-ops on every captured exception.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
LOG_LEVEL=

# ── PostHog (product telemetry — production/preview only; opted out in development)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Client-side debug/trace flags (all optional, default off) ──────────────
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_BLACKSCREEN_TRACE=
NEXT_PUBLIC_DEBUG_PLAYBACK_EVENTS=
NEXT_PUBLIC_MEDIA_DETERMINISM_DEBUG=
NEXT_PUBLIC_PLAYBACK_TRACE=
NEXT_PUBLIC_RELEASE_PRESENTATION_TRACE=
NEXT_PUBLIC_STATE_CHURN_LOG=
NEXT_PUBLIC_UI_HYDRATION_TRACE=
IDLE_POLL_MS=
MRRW_READINESS_TIMEOUT_MS=

# ── Storefront canonical URLs ────────────────────────────────────────────────
# Checkout redirects, gift emails — not for internal /api fetch.
NEXT_PUBLIC_SITE_URL=https://www.2mrrw.com
NEXT_PUBLIC_BASE_URL=
# Control System catalog (cross-origin reads + playback analytics POST)
NEXT_PUBLIC_CONTROL_SYSTEM_API_URL=https://2mrrw-control-system.vercel.app
NEXT_PUBLIC_CONTROL_SYSTEM_URL=

# ── Phase 5.2 — Hybrid master/stream flags (server-side only; default OFF) ──
# Truthy: 1 or true. All other values (unset, 0, false) = disabled.
#
# Production default (master-only playback — safe rollback baseline):
#   HYBRID_STREAMING_ENABLED=0
#   STREAM_PLAYBACK_PREFERRED=0
#
# Staging / canary (Phase 5.3.4 — hybrid activation validation):
#   HYBRID_STREAMING_ENABLED=1
#   STREAM_PLAYBACK_PREFERRED=1
#   AUTO_GENERATE_STREAM_ASSETS=0   # keep OFF unless running upload pipeline / backfill
# Rollback: set STREAM_PLAYBACK_PREFERRED=0 or HYBRID_STREAMING_ENABLED=0 → master playback, no data restore.
HYBRID_STREAMING_ENABLED=0
STREAM_PLAYBACK_PREFERRED=0
AUTO_GENERATE_STREAM_ASSETS=0

# ── Phase 5.2.13 — Direct preview CDN (default OFF; staging canary only) ────
# Truthy: 1 or true. When OFF, previews use /api/media/preview (unchanged).
# Client flag required for browser resolver; server flag optional for SSR.
DIRECT_PREVIEW_ENABLED=0
NEXT_PUBLIC_DIRECT_PREVIEW_CDN=0

# ── Direct stream redirect ───────────────────────────────────────────────────
# Removes the server proxy hop for library streams. When ON:
# /api/library/stream?redirect=1 returns a 302 directly to the signed R2 URL.
# PREREQUISITE: R2 bucket CORS must be live for the signed S3 endpoint —
# apply docs/reports/r2-cors-policy-recommended.json to the R2 bucket first.
# Rollback: set to 0 and redeploy — no code change needed.
DIRECT_STREAM_REDIRECT_ENABLED=1

# ── Misc dev tooling [SCRIPT] ─────────────────────────────────────────────────
# scripts/check-scoped-changes.mjs — restricts a diff-check script to one path prefix.
SCOPE=

# ── E2E / integration test tooling [SCRIPT] ──────────────────────────────────
# Read only by test scripts, never by the running app.
E2E_SUPABASE_URL=
E2E_SUPABASE_SECRET_KEY=
E2E_SESSION_COOKIE=
E2E_USER_ID=
E2E_PRODUCT_SLUG=
E2E_STREAM_BASE_URL=
