{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/collector/layout,_N_T_/collector/activate/layout,_N_T_/collector/activate/page,_N_T_/collector/activate"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/collector/activate/__PAGE__",
    "/collector/activate",
    "/collector",
    "/_index",
    "/_head"
  ]
}